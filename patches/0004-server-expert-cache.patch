 constexpr int HTTP_POLLING_SECONDS = 1;
 
+// moe-stream: with MOE_CACHE_SLOTS > 0 or auto, MoE experts come from an explicit cache (examples/moe-run) instead of
+// the mmap: small batches from the slots, larger ones (prompt processing) streamed layer by layer unless
+// MOE_STREAM_PREFILL=0. MOE_IO_THREADS, MOE_CACHE_MAX_TOKENS and MOE_EXPERTS_FILE (bundled sidecar) are optional.
+struct moe_stream {
+    expert_cache ec;
+    int          last_il = INT_MAX;
+    uint64_t     token   = 0;
+};
+
+static std::unique_ptr<moe_stream> g_moe_stream;
+
+static bool moe_stream_cb_eval(ggml_tensor * t, bool ask, void * user_data) {
+    static const char prefix[] = "ffn_moe_slot_ids-";
+    if (strncmp(t->name, prefix, sizeof(prefix) - 1) != 0) {
+        return false;
+    }
+    const char * num = t->name + sizeof(prefix) - 1;
+    if (*num == 0 || strspn(num, "0123456789") != strlen(num)) {
+        return false; // derived names like "... (reshaped)"
+    }
+    if (ask) {
+        return true;
+    }
+    auto * ms = (moe_stream *) user_data;
+    const int il = atoi(num);
+    if (il <= ms->last_il) {
+        ms->token++; // back at the first MoE layer: next decode step
+    }
+    ms->last_il = il;
+    ms->ec.on_ids(il, (int32_t *) t->data, t->ne[0], t->ne[1], ms->token);
+    return true;
+}
+
+static int moe_stream_env(const char * name, int def) {
+    const char * v = getenv(name);
+    return v && *v ? atoi(v) : def;
+}
